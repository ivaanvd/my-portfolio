---
import { Download } from '@lucide/astro';
---
<section class="bg-ink text-white h-dvh snap-start snap-always px-16 pt-32">
    <div class="flex justify-between font-mono text-xs text-white/60 mb-12">
        <span>
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-garnet-bright mr-2"></span>
            LOC: ZARAGOZA
        </span>
        <span>STATUS: OPEN_TO_WORK</span>
    </div>

    <div class="hero-content max-w-xl">
        <span class="inline-block font-mono text-xs text-garnet-bright border border-garnet-dim bg-garnet/10 px-2.5 py-1 rounded mb-5">
            // WELCOME
        </span>

        <h1 class="font-display font-black text-7xl uppercase leading-none tracking-tight">
            Iván<br />Vayad
        </h1>

        <p class="font-mono text-garnet-bright text-base mt-4">
            Software engineer &mdash; full stack
        </p>

        <div class="flex gap-3 mt-9">
            <a href="/cv_ivan_vayad.pdf" target="_blank" rel="noopener noreferrer"
               class="font-mono text-sm uppercase tracking-wide bg-garnet text-white px-5 py-3 rounded hover:bg-garnet-bright cursor-pointer inline-flex items-center">
                VER CURRICULUM
            </a>
            <a href="/cv_ivan_vayad.pdf" download="ivan_vayad-cv.pdf" aria-label="Descargar currículum"
               class="font-mono text-sm uppercase tracking-wide border border-white/20 text-white px-5 py-3 rounded hover:bg-white/10 cursor-pointer flex items-center justify-center gap-2 transition-all duration-200">
                <Download size={16} />
            </a>
        </div>
    </div>

    <p class="font-mono text-xs text-white/40 text-right mt-24">
        SCROLL_TO_CONTINUE &darr;
    </p>
</section>
