---
import { Download } from '@lucide/astro';
---

<section
    id="hero-section"
    class="bg-ink text-white h-dvh px-6 md:px-16 pt-28 md:pt-32 relative overflow-hidden flex flex-col justify-between pb-12"
>
    <!-- Capa de loading -->
    <div
        id="hero-loader-bg"
        class="fixed inset-0 bg-ink z-50 pointer-events-none flex flex-col items-center justify-center"
    >
        <div id="hero-loader-brand" class="font-display font-black text-5xl md:text-8xl tracking-tight text-white mb-8 text-center opacity-0 scale-95">
            IVÁN VAYAD
        </div>
        <p
            id="hero-loader-text"
            class="font-mono text-garnet-bright text-xs md:text-sm tracking-widest uppercase"
        >
            LOADING<span class="preloader-dots"></span>
        </p>
    </div>

    <div
        id="hero-meta"
        class="flex justify-between font-mono text-xs text-white/60 mb-6 md:mb-12 opacity-0"
    >
        <span class="flex items-center">
            <span class="inline-block w-2 h-2 rounded-full bg-garnet-bright mr-2 animate-pulse"></span>
            LOC: ZARAGOZA
        </span>

        <span>STATUS: OPEN_TO_WORK</span>
    </div>

    <div class="hero-content max-w-xl my-auto">
        <div id="hero-tag" class="opacity-0">
            <span
                class="inline-block font-mono text-xs text-garnet-bright border border-garnet-dim bg-garnet/10 px-3 py-1.5 rounded mb-5"
            >
                // WELCOME
            </span>
        </div>

        <h1
            id="hero-title"
            class="font-display font-black text-5xl sm:text-7xl md:text-8xl uppercase leading-none tracking-tight overflow-hidden"
        >
            <span id="hero-name-ivan" class="inline-block">Iván</span>
            <br />
            <span id="hero-name-vayad" class="inline-block">Vayad</span>
        </h1>

        <div id="hero-body" class="opacity-0">
            <p class="font-mono text-garnet-bright text-base md:text-lg mt-4">
                Software engineer &mdash; full stack
            </p>

            <div class="flex flex-wrap gap-3 mt-8">
                <a
                    href="/cv_ivan_vayad.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-xs md:text-sm uppercase tracking-wide bg-garnet text-white px-6 py-3.5 rounded hover:bg-garnet-bright transition-all duration-200 cursor-pointer inline-flex items-center no-underline shadow-lg hover:shadow-garnet/40"
                >
                    VER CURRICULUM
                </a>

                <a
                    href="/cv_ivan_vayad.pdf"
                    download="ivan_vayad-cv.pdf"
                    aria-label="Descargar currículum"
                    class="font-mono text-xs md:text-sm uppercase tracking-wide border border-white/20 text-white px-5 py-3.5 rounded hover:bg-white/10 cursor-pointer flex items-center justify-center gap-2 transition-all duration-200 no-underline"
                >
                    <Download size={16} />
                </a>
            </div>
        </div>
    </div>

    <p
        id="hero-scroll"
        class="font-mono text-xs text-white/40 text-right opacity-0"
    >
        SCROLL_TO_CONTINUE &darr;
    </p>
</section>

<script>
    import { gsap } from 'gsap';

    function triggerHeroIntro() {
        const loaderBg = document.getElementById('hero-loader-bg');
        const loaderBrand = document.getElementById('hero-loader-brand');
        const loaderText = document.getElementById('hero-loader-text');
        
        const ivan = document.getElementById('hero-name-ivan');
        const vayad = document.getElementById('hero-name-vayad');
        
        const meta = document.getElementById('hero-meta');
        const tag = document.getElementById('hero-tag');
        const body = document.getElementById('hero-body');
        const scroll = document.getElementById('hero-scroll');

        if (!loaderBg || !ivan || !vayad) return;

        if (loaderBg.dataset.started === 'true') return;
        loaderBg.dataset.started = 'true';

        const tl = gsap.timeline({
            onComplete: () => {
                if (loaderBg) loaderBg.style.display = 'none';
            }
        });

        // 1. Reveal loader brand text
        tl.to(loaderBrand, {
            opacity: 1,
            scale: 1,
            duration: 0.7,
            ease: 'power3.out'
        })
        .to(loaderText, {
            opacity: 0,
            duration: 0.4,
            delay: 0.5
        })
        .to(loaderBrand, {
            opacity: 0,
            y: -20,
            duration: 0.4
        }, '-=0.2')
        .to(loaderBg, {
            opacity: 0,
            duration: 0.6,
            ease: 'power2.inOut'
        })
        // 2. Animate Hero Title Names
        .fromTo([ivan, vayad], {
            y: 80,
            opacity: 0,
            rotateX: 30
        }, {
            y: 0,
            opacity: 1,
            rotateX: 0,
            duration: 0.9,
            stagger: 0.15,
            ease: 'power4.out'
        }, '-=0.3')
        // 3. Fade in supporting elements
        .to([meta, tag, body, scroll], {
            opacity: 1,
            y: 0,
            duration: 0.6,
            stagger: 0.1,
            ease: 'power2.out'
        }, '-=0.5');
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', triggerHeroIntro);
    } else {
        triggerHeroIntro();
    }
    document.addEventListener('astro:page-load', triggerHeroIntro);
</script>