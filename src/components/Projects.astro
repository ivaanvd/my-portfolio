---
import { getCollection } from 'astro:content';
import { ExternalLink } from '@lucide/astro';

const projects = await getCollection('projects');
---

<section
  id="projects-section"
  class="bg-ink text-white min-h-dvh px-6 md:px-16 pt-20 md:pt-28 pb-24 md:pb-32 relative overflow-hidden"
>
  <div id="projects-header" class="text-center mb-12 max-w-2xl mx-auto overflow-hidden">
    <p class="font-mono text-xs text-garnet-bright tracking-widest uppercase mb-4 font-semibold reveal-clip">
      // SECCIÓN 02 &mdash; PROYECTOS DESTACADOS
    </p>

    <h2 class="font-serif font-bold text-4xl sm:text-6xl reveal-clip">
      Selected <span class="text-garnet-bright italic">Projects</span>
    </h2>
  </div>

  <!-- CATEGORY FILTER TABS -->
  <div id="project-filter-tabs" class="flex flex-wrap items-center justify-center gap-2 mb-10 md:mb-16 font-mono text-[10px] md:text-xs">
    <button
      data-filter="all"
      class="filter-btn active px-3 py-1.5 md:px-4 md:py-2 rounded-full border border-garnet-bright bg-garnet text-white cursor-pointer transition-all duration-200"
    >
      Todos (4)
    </button>
    <button
      data-filter="fullstack"
      class="filter-btn px-3 py-1.5 md:px-4 md:py-2 rounded-full border border-white/10 bg-white/5 text-white/70 hover:border-white/30 hover:text-white cursor-pointer transition-all duration-200"
    >
      Full Stack
    </button>
    <button
      data-filter="frontend"
      class="filter-btn px-3 py-1.5 md:px-4 md:py-2 rounded-full border border-white/10 bg-white/5 text-white/70 hover:border-white/30 hover:text-white cursor-pointer transition-all duration-200"
    >
      Frontend
    </button>
    <button
      data-filter="movil"
      class="filter-btn px-3 py-1.5 md:px-4 md:py-2 rounded-full border border-white/10 bg-white/5 text-white/70 hover:border-white/30 hover:text-white cursor-pointer transition-all duration-200"
    >
      Móvil & Robótica
    </button>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16 max-w-6xl mx-auto project-card-container">
    {
      projects.map(({ data: { id, num, title, category, description, tags } }, index) => (
        <a
          href={`/proyectos/${id}`}
          class:list={[
            'project-card group cursor-pointer transition-all duration-400 no-underline block',
            index % 2 === 1 && 'md:mt-16',
          ]}
          data-category={category}
        >
          <div class="project-card-tilt relative bg-ink-2 rounded-xl overflow-hidden border border-white/10 mb-6 aspect-video transition-all duration-300 group-hover:border-garnet/50">
            <div class="flex items-center justify-between px-4 py-3 bg-black/40 border-b border-white/5">
              <div class="flex gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-red-500/60" />
                <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/60" />
                <span class="w-2.5 h-2.5 rounded-full bg-green-500/60" />
              </div>
              <span class="font-mono text-[10px] text-white/40 uppercase">PROJECT_{num}</span>
            </div>

            <div class="flex flex-col items-center justify-center h-[calc(100%-42px)] p-6 bg-gradient-to-br from-white/5 to-transparent text-center">
              <span class="font-display font-black text-4xl md:text-5xl text-white/10 group-hover:text-garnet-bright/30 transition-colors duration-300">
                {num}
              </span>
              <p class="font-mono text-xs text-white/40 mt-2">{title.toUpperCase()}</p>
            </div>
          </div>

          <div class="flex items-start justify-between gap-4 mb-2">
            <h3 class="font-display font-bold text-2xl md:text-3xl text-white group-hover:text-garnet-bright transition-colors duration-200">
              {title}
            </h3>

            <div class="flex items-center gap-1.5 font-mono text-xs text-garnet-bright group-hover:translate-x-1 transition-transform">
              <span>Ver proyecto</span>
              <ExternalLink size={16} />
            </div>
          </div>

          <p class="text-white/70 text-sm leading-relaxed mb-4 max-w-md font-sans">
            {description}
          </p>

          <div class="flex flex-wrap gap-2.5 font-mono text-xs text-white/50">
            {tags.map((tag) => (
              <span class="px-2.5 py-1 rounded bg-white/5 border border-white/10 group-hover:border-garnet-dim">
                {tag}
              </span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function setupProjects() {
    const headerEl = document.getElementById('projects-header');
    const cards = document.querySelectorAll('.project-card');
    const filterBtns = document.querySelectorAll('.filter-btn');

    // 1. Clip-Path Reveal Entrance
    if (headerEl) {
      gsap.fromTo(
        headerEl.querySelectorAll('.reveal-clip'),
        { clipPath: 'inset(0 0 100% 0)', y: 30, opacity: 0 },
        {
          clipPath: 'inset(0 0 0% 0)',
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.15,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#projects-section',
            start: 'top 90%',
            toggleActions: 'play none none none'
          }
        }
      );
    }

    if (cards.length) {
      gsap.fromTo(
        cards,
        { clipPath: 'inset(0 0 100% 0)', y: 40, opacity: 0 },
        {
          clipPath: 'inset(0 0 0% 0)',
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.18,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '.project-card-container',
            start: 'top 90%',
            toggleActions: 'play none none none'
          }
        }
      );
    }

    // 2. Interactive Category Filter
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Toggle active button style
        filterBtns.forEach((b) => {
          b.classList.remove('bg-garnet', 'border-garnet-bright', 'text-white', 'active');
          b.classList.add('bg-white/5', 'border-white/10', 'text-white/70');
        });
        btn.classList.remove('bg-white/5', 'border-white/10', 'text-white/70');
        btn.classList.add('bg-garnet', 'border-garnet-bright', 'text-white', 'active');

        // Filter cards
        cards.forEach((card) => {
          const cat = card.getAttribute('data-category');
          if (filter === 'all' || cat === filter) {
            gsap.to(card, {
              scale: 1,
              opacity: 1,
              display: 'block',
              duration: 0.4,
              ease: 'power2.out'
            });
          } else {
            gsap.to(card, {
              scale: 0.9,
              opacity: 0,
              display: 'none',
              duration: 0.3,
              ease: 'power2.in'
            });
          }
        });
      });
    });

    // 3. 3D Tilt Effect on mousemove
    cards.forEach((card) => {
      const tiltEl = card.querySelector('.project-card-tilt') as HTMLElement;
      if (!tiltEl) return;

      card.addEventListener('mousemove', (e: Event) => {
        const mouseEvent = e as MouseEvent;
        const rect = card.getBoundingClientRect();
        const x = mouseEvent.clientX - rect.left;
        const y = mouseEvent.clientY - rect.top;

        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        const rotateX = ((y - centerY) / centerY) * -10;
        const rotateY = ((x - centerX) / centerX) * 10;

        tiltEl.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
      });

      card.addEventListener('mouseleave', () => {
        tiltEl.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
      });
    });

    ScrollTrigger.refresh();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupProjects);
  } else {
    setupProjects();
  }
  document.addEventListener('astro:page-load', setupProjects);
</script>