---
import { CodeXml, LayoutPanelTop, Server, Wrench } from '@lucide/astro';

const categories = [
  {
    icon: CodeXml,
    label: 'Lenguajes',
    items: ['JavaScript (ES6+)', 'TypeScript', 'Python', 'Java'],
    color: 'from-garnet/30 to-transparent',
  },
  {
    icon: LayoutPanelTop,
    label: 'Frontend',
    items: ['React / Next.js', 'Tailwind CSS', 'HTML / CSS', 'Framer Motion'],
    color: 'from-blue-900/30 to-transparent',
  },
  {
    icon: Server,
    label: 'Backend',
    items: ['Node.js / Express', 'PostgreSQL', 'MongoDB', 'REST APIs'],
    color: 'from-emerald-900/30 to-transparent',
  },
  {
    icon: Wrench,
    label: 'Tools & DevOps',
    items: ['Git & GitHub', 'Docker', 'Figma', 'Jest / Testing'],
    color: 'from-purple-900/30 to-transparent',
  },
];
---

<section
  id="about-section"
  class="bg-cream text-ink min-h-dvh relative overflow-hidden py-16 md:py-24 px-6 md:px-16 flex flex-col justify-between"
>
  <!-- Decorative big number -->
  <span
    class="absolute -top-10 right-0 font-serif font-bold text-[18rem] md:text-[28rem] leading-none text-ink/5 select-none pointer-events-none"
  >
    01
  </span>

  <!-- TITLE BLOCK -->
  <div id="about-title-block" class="about-title max-w-3xl relative z-10">
    <p class="font-mono text-xs text-garnet mb-3 tracking-wide relative uppercase font-semibold">
      // SECCIÓN 01 &mdash; SOBRE MÍ & STACK
    </p>

    <h2 class="font-serif font-semibold text-4xl sm:text-6xl md:text-7xl leading-none mb-4 relative">
      Technical<br />
      <span class="text-garnet italic">Skills & Architecture</span>
    </h2>
  </div>

  <!-- MOBILE-ONLY SKILLS GRID (visible md:hidden) -->
  <!-- On desktop the MorphBox handles this. On mobile we render an inline grid -->
  <div class="md:hidden mt-10 relative z-10 grid grid-cols-2 gap-4" id="mobile-skills-grid">
    {categories.map(({ icon: Icon, label, items, color }) => (
      <div class={`rounded-2xl bg-gradient-to-br ${color} border border-ink/10 p-5 flex flex-col gap-3`}>
        <div class="flex items-center gap-2 mb-1">
          <div class="w-7 h-7 rounded-lg bg-garnet/15 flex items-center justify-center shrink-0">
            <Icon size={14} class="text-garnet" />
          </div>
          <span class="font-mono text-[10px] uppercase tracking-widest font-bold text-ink/70">
            {label}
          </span>
        </div>
        <ul class="space-y-1.5">
          {items.map((item) => (
            <li class="flex items-center gap-2 font-mono text-xs text-ink/80">
              <span class="w-1.5 h-1.5 rounded-full bg-garnet/50 shrink-0"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <!-- BOTTOM HINT (mobile only) -->
  <p class="md:hidden mt-8 font-mono text-[10px] text-ink/40 uppercase tracking-widest text-center relative z-10">
    Scroll para ver proyectos &darr;
  </p>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function animateAboutTitle() {
    const titleBlock = document.getElementById('about-title-block');
    if (!titleBlock) return;

    gsap.fromTo(
      titleBlock.children,
      { y: 50, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.7,
        stagger: 0.12,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '#about-section',
          start: 'top 85%',
          toggleActions: 'play none none none'
        }
      }
    );

    // Animate mobile skills grid cards
    const mobileCards = document.querySelectorAll('#mobile-skills-grid > div');
    if (mobileCards.length) {
      gsap.fromTo(
        mobileCards,
        { y: 30, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.6,
          stagger: 0.1,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: '#mobile-skills-grid',
            start: 'top 90%',
            toggleActions: 'play none none none'
          }
        }
      );
    }

    ScrollTrigger.refresh();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', animateAboutTitle);
  } else {
    animateAboutTitle();
  }
  document.addEventListener('astro:page-load', animateAboutTitle);
</script>