---
const currentPath = Astro.url.pathname;

const links = [
  { href: '/sobre-mi', label: 'Sobre mí' },
  { href: '/stack', label: 'Stack' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/contacto', label: 'Contacto' },
];
---

<div id="navbar" class="navbar-wrap fixed top-0 inset-x-0 z-40 h-[64px] md:h-[76px] is-dark">
  <nav class="relative h-full px-6 md:px-16 flex items-center justify-between font-mono text-sm">

    <!-- LOGO -->
    <a href="/" class="font-bold text-lg hover:scale-110 inline-block transition-transform duration-200 no-underline text-current z-50 relative">
      IV<span class="text-garnet-bright">.</span>
    </a>

    <!-- DESKTOP NAV LINKS -->
    <div class="hidden md:flex gap-8">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'hover:text-garnet-bright transition-colors no-underline text-current',
            (currentPath === href || currentPath === `${href}/`) && 'text-garnet-bright font-bold',
          ]}
        >
          {label}
        </a>
      ))}
    </div>

    <!-- MOBILE HAMBURGER BUTTON -->
    <button
      id="nav-hamburger"
      class="md:hidden relative z-[60] w-10 h-10 flex flex-col items-center justify-center gap-[5px] cursor-pointer bg-transparent border-0 p-0"
      aria-label="Abrir menú"
    >
      <span id="ham-1" class="block w-6 h-[2px] bg-current rounded-full"></span>
      <span id="ham-2" class="block w-6 h-[2px] bg-current rounded-full"></span>
      <span id="ham-3" class="block w-4 h-[2px] bg-current rounded-full self-start"></span>
    </button>
  </nav>
</div>

<!-- MOBILE MENU OVERLAY — outside navbar, full screen -->
<div
  id="mobile-menu"
  style="display:none; position:fixed; inset:0; z-index:50; background:rgba(14,11,11,0.97); backdrop-filter:blur(20px); flex-direction:column; align-items:center; justify-content:center; gap:2rem;"
>
  <!-- Grid pattern background -->
  <div style="position:absolute;inset:0;opacity:0.04;background-image:radial-gradient(#9B111E 1px,transparent 1px);background-size:24px 24px;pointer-events:none;"></div>

  {links.map(({ href, label }, idx) => (
    <a
      href={href}
      id={`mobile-link-${idx}`}
      class:list={[
        'mobile-nav-link font-display font-black uppercase no-underline',
        (currentPath === href || currentPath === `${href}/`) ? 'text-garnet-bright' : 'text-white',
      ]}
      style="font-size:clamp(2.5rem,10vw,4rem); line-height:1; opacity:0; transform:translateX(40px);"
    >
      {label}
    </a>
  ))}

  <p style="position:absolute;bottom:3rem;font-family:var(--font-mono);font-size:0.6rem;color:rgba(255,255,255,0.2);letter-spacing:0.2em;text-transform:uppercase;">
    ivan@portfolio:~ // MENU
  </p>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function setupNavbar() {
    const navbar = document.getElementById('navbar');
    const hamburger = document.getElementById('nav-hamburger');
    const mobileMenu = document.getElementById('mobile-menu') as HTMLElement | null;
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');
    const ham1 = document.getElementById('ham-1');
    const ham2 = document.getElementById('ham-2');
    const ham3 = document.getElementById('ham-3');
    const aboutSection = document.getElementById('about-section');

    let menuOpen = false;

    if (!hamburger || !mobileMenu) return;

    function openMenu() {
      if (!mobileMenu) return;
      menuOpen = true;
      mobileMenu.style.display = 'flex';

      // Fade in overlay
      gsap.fromTo(mobileMenu,
        { opacity: 0 },
        { opacity: 1, duration: 0.3, ease: 'power2.out' }
      );

      // Animate links staggered
      gsap.fromTo(mobileLinks,
        { opacity: 0, x: 40 },
        { opacity: 1, x: 0, duration: 0.4, stagger: 0.07, ease: 'power3.out', delay: 0.1 }
      );

      // Hamburger → X
      gsap.to(ham1, { rotate: 45, y: 7, duration: 0.25, ease: 'power2.inOut' });
      gsap.to(ham2, { opacity: 0, duration: 0.15 });
      gsap.to(ham3, { rotate: -45, y: -7, width: 24, duration: 0.25, ease: 'power2.inOut' });

      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      if (!mobileMenu) return;
      menuOpen = false;
      document.body.style.overflow = '';

      // Fade out overlay
      gsap.to(mobileMenu, {
        opacity: 0,
        duration: 0.25,
        ease: 'power2.in',
        onComplete: () => {
          if (mobileMenu) mobileMenu.style.display = 'none';
        }
      });

      // Reset links
      gsap.to(mobileLinks, { opacity: 0, x: 40, duration: 0.2 });

      // X → hamburger
      gsap.to(ham1, { rotate: 0, y: 0, duration: 0.25, ease: 'power2.inOut' });
      gsap.to(ham2, { opacity: 1, duration: 0.2 });
      gsap.to(ham3, { rotate: 0, y: 0, width: 16, duration: 0.25, ease: 'power2.inOut' });
    }

    hamburger.addEventListener('click', () => {
      menuOpen ? closeMenu() : openMenu();
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menuOpen) closeMenu();
    });

    // --- NAVBAR THEME SWITCHING ---
    if (!navbar) return;

    if (!aboutSection) {
      navbar.classList.remove('is-light');
      navbar.classList.add('is-dark');
      return;
    }

    ScrollTrigger.create({
      trigger: aboutSection,
      start: 'top 10%',
      end: 'bottom 10%',
      onEnter: () => { navbar.classList.remove('is-dark'); navbar.classList.add('is-light'); },
      onLeave: () => { navbar.classList.remove('is-light'); navbar.classList.add('is-dark'); },
      onEnterBack: () => { navbar.classList.remove('is-dark'); navbar.classList.add('is-light'); },
      onLeaveBack: () => { navbar.classList.remove('is-light'); navbar.classList.add('is-dark'); }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNavbar);
  } else {
    setupNavbar();
  }
  document.addEventListener('astro:page-load', setupNavbar);
</script>