---
import Layout from '../../layouts/Layout.astro';
import ScreenCarousel from '../../components/Screencarousel.astro';
import VideoModal from '../../components/VideoModal.astro';
import { getCollection } from 'astro:content';
import {
  ArrowLeft,
  Users,
  Calendar,
  Building2,
  Layers,
  Check,
  ArrowRight,
  Monitor,
  FileText
} from '@lucide/astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.data.id },
    props: { project, allProjects: projects },
  }));
}

const { project, allProjects } = Astro.props;
const {
  num,
  title,
  subtitle,
  category,
  fullDescription,
  authors,
  year,
  institution,
  architecture,
  features,
  tags,
  repoUrl,
  demoVideo,
  documentationUrl,
  imagesWeb = [],
  imagesMobile = []
} = project.data;

const hasWeb = imagesWeb.length > 0;
const hasMobile = imagesMobile.length > 0;

// Pantalla del ordenador:
//  - con capturas web            -> se muestran
//  - sin web pero con móvil      -> no se muestra el ordenador (solo el móvil)
//  - sin ninguna captura         -> 3 placeholders para no dejar la página vacía
const webSlides: (string | null)[] = hasWeb
  ? imagesWeb
  : hasMobile
    ? []
    : [null, null, null];
const showMonitor = webSlides.length > 0;

// Find next and previous projects for bottom navigation
const currentIndex = allProjects.findIndex((p) => p.data.id === project.data.id);
const prevProject = allProjects[(currentIndex - 1 + allProjects.length) % allProjects.length];
const nextProject = allProjects[(currentIndex + 1) % allProjects.length];
---

<Layout title={`${title} — Proyecto Iván Vayad`}>
  <main class="min-h-dvh bg-ink text-white pt-28 pb-32 px-6 md:px-16 max-w-6xl mx-auto overflow-hidden">

    <!-- BACK BUTTON -->
    <div class="mb-8">
      <a
        href="/proyectos"
        class="inline-flex items-center gap-2 font-mono text-xs text-white/60 hover:text-garnet-bright transition-colors uppercase tracking-wider no-underline group"
      >
        <ArrowLeft size={16} class="group-hover:-translate-x-1 transition-transform" />
        Volver a Proyectos
      </a>
    </div>

    <!-- HEADER SECTION & MAIN ACTIONS -->
    <header id="project-header" class="mb-12">
      <div class="flex items-center gap-3 mb-4 font-mono text-xs text-garnet-bright tracking-widest uppercase">
        <span class="px-2.5 py-1 rounded bg-garnet/20 border border-garnet-dim font-bold">
          PROJECT_{num}
        </span>
        <span>// {category}</span>
      </div>

      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-6">
        <div>
          <h1 class="font-display font-black text-4xl sm:text-6xl md:text-7xl uppercase leading-none tracking-tight mb-4 text-white">
            {title}
          </h1>

          <p class="font-mono text-base md:text-lg text-garnet-bright max-w-3xl font-medium leading-relaxed">
            {subtitle}
          </p>
        </div>

        <!-- ACTION BUTTONS: GITHUB, DOCUMENTATION, VIDEO DEMO (opcional) -->
        <div class="flex flex-wrap items-center gap-3 shrink-0">
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider bg-white/5 hover:bg-garnet border border-white/20 hover:border-garnet-bright text-white px-4 py-3 rounded-lg transition-all duration-200 no-underline shadow-md"
            title="Ver código fuente en GitHub"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            Ver Repositorio
          </a>

          <a
            href={documentationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider bg-white/5 hover:bg-garnet border border-white/20 hover:border-garnet-bright text-white px-4 py-3 rounded-lg transition-all duration-200 no-underline shadow-md"
            title="Ver documentación en PDF"
          >
            <FileText size={16} class="text-garnet-bright" />
            Ver Documentación
          </a>

          {demoVideo && <VideoModal src={demoVideo} title={title} />}
        </div>
      </div>
    </header>

    <!-- DEVICES SHOWCASE: ordenador (capturas web) + móvil (solo si hay capturas móvil) -->
    <div
      id="project-banner"
      class="relative max-w-5xl mx-auto mb-16 flex flex-col lg:flex-row items-center lg:items-end justify-center gap-10 lg:gap-12"
    >

      {showMonitor && (
        <div class="w-full min-w-0 lg:flex-1">
          <!-- Monitor / browser frame -->
          <div class="relative rounded-2xl bg-ink-2 border border-white/15 overflow-hidden shadow-2xl flex flex-col">

            <!-- Browser Top Bar -->
            <div class="flex items-center justify-between px-4 py-3 bg-black/80 border-b border-white/10 font-mono text-xs text-white/40 shrink-0">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
                <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
              </div>

              <div class="flex items-center gap-2 bg-white/5 border border-white/10 rounded-md px-4 py-1 text-[11px] text-white/90 font-medium max-w-md w-full justify-center truncate font-mono">
                {title}
              </div>

              <div class="flex items-center gap-2">
                <Monitor size={14} class="text-white/40" />
              </div>
            </div>

            <!-- Área de la pantalla del monitor -->
            <div class="w-full relative overflow-hidden bg-black">
              <ScreenCarousel slides={webSlides} alt={title} variant="web" fit="cover" />
            </div>
          </div>

          <!-- Stand / base -->
          <div class="h-3 bg-gradient-to-b from-white/20 to-white/5 rounded-b-xl w-3/4 mx-auto border-t border-white/10 shadow-lg"></div>
        </div>
      )}

      {hasMobile && (
        <div class="shrink-0 w-[200px] sm:w-[230px]">
          <!-- Phone frame -->
          <div class="relative rounded-[2.5rem] bg-ink-2 border border-white/15 p-2.5 shadow-2xl">
            <!-- Botones laterales -->
            <span class="absolute -left-[3px] top-20 w-[3px] h-8 rounded-l bg-white/20 pointer-events-none"></span>
            <span class="absolute -left-[3px] top-32 w-[3px] h-12 rounded-l bg-white/20 pointer-events-none"></span>
            <span class="absolute -right-[3px] top-28 w-[3px] h-16 rounded-r bg-white/20 pointer-events-none"></span>

            <div class="relative rounded-[2rem] overflow-hidden bg-black border border-white/10">
              <!-- Notch / dynamic island -->
              <div class="absolute top-2 left-1/2 -translate-x-1/2 z-30 w-16 h-4 rounded-full bg-black border border-white/10 pointer-events-none"></div>

              <ScreenCarousel slides={imagesMobile} alt={`${title} (móvil)`} variant="mobile" fit="cover" />

              <!-- Home indicator -->
              <div class="absolute bottom-1.5 left-1/2 -translate-x-1/2 z-30 w-20 h-1 rounded-full bg-white/40 pointer-events-none"></div>
            </div>
          </div>
        </div>
      )}
    </div>

    <!-- MAIN CONTENT GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">

      <!-- LEFT / MAIN COL (2 COLS) -->
      <div class="lg:col-span-2 space-y-14">

        <!-- DESCRIPTION SECTION -->
        <section class="space-y-4">
          <h2 class="font-serif font-bold text-2xl md:text-3xl text-white flex items-center gap-3">
            <span class="w-2 h-6 bg-garnet-bright rounded-full"></span>
            Descripción General
          </h2>

          <p class="text-white/80 leading-relaxed text-base md:text-lg font-sans">
            {fullDescription}
          </p>
        </section>

        <!-- ARCHITECTURE SECTION -->
        <section class="space-y-6">
          <h2 class="font-serif font-bold text-2xl md:text-3xl text-white flex items-center gap-3">
            <span class="w-2 h-6 bg-garnet-bright rounded-full"></span>
            Arquitectura & Decisiones Técnicas
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {architecture.map((item, idx) => (
              <div class="bg-ink-2 border border-white/10 rounded-xl p-5 hover:border-garnet/40 transition-colors flex items-start gap-3">
                <div class="w-7 h-7 rounded-lg bg-garnet/20 border border-garnet-dim shrink-0 flex items-center justify-center text-garnet-bright font-mono text-xs font-bold mt-0.5">
                  0{idx + 1}
                </div>
                <p class="text-white/80 font-mono text-xs leading-relaxed">
                  {item}
                </p>
              </div>
            ))}
          </div>
        </section>

        <!-- KEY FEATURES SECTION -->
        <section class="space-y-6">
          <h2 class="font-serif font-bold text-2xl md:text-3xl text-white flex items-center gap-3">
            <span class="w-2 h-6 bg-garnet-bright rounded-full"></span>
            Funcionalidades Clave
          </h2>

          <div class="bg-ink-2 border border-white/10 rounded-xl p-6 md:p-8 space-y-4">
            {features.map((feat) => (
              <div class="flex items-start gap-3">
                <Check size={18} class="text-garnet-bright shrink-0 mt-1" />
                <p class="text-white/80 font-sans text-sm md:text-base leading-relaxed">
                  {feat}
                </p>
              </div>
            ))}
          </div>
        </section>
      </div>

      <!-- RIGHT SIDEBAR COL (1 COL) -->
      <aside class="space-y-8 lg:sticky lg:top-28">

        <!-- METADATA CARD -->
        <div class="bg-ink-2 border border-white/10 rounded-2xl p-6 md:p-8 space-y-6">
          <h3 class="font-mono text-xs text-garnet-bright uppercase tracking-widest font-semibold border-b border-white/10 pb-4">
            // FICHA TÉCNICA
          </h3>

          <!-- Authors -->
          <div class="space-y-2">
            <span class="font-mono text-xs text-white/40 flex items-center gap-2">
              <Users size={14} /> Autores del Proyecto
            </span>
            <ul class="space-y-1">
              {authors.map((author) => (
                <li class="font-mono text-xs text-white font-medium flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-garnet-bright"></span>
                  {author}
                </li>
              ))}
            </ul>
          </div>

          <!-- Institution -->
          <div class="space-y-1">
            <span class="font-mono text-xs text-white/40 flex items-center gap-2">
              <Building2 size={14} /> Contexto / Institución
            </span>
            <p class="font-mono text-xs text-white leading-relaxed">
              {institution}
            </p>
          </div>

          <!-- Year -->
          <div class="space-y-1">
            <span class="font-mono text-xs text-white/40 flex items-center gap-2">
              <Calendar size={14} /> Año de Desarrollo
            </span>
            <p class="font-mono text-xs text-white font-semibold">
              {year}
            </p>
          </div>

          <!-- Category -->
          <div class="space-y-1">
            <span class="font-mono text-xs text-white/40 flex items-center gap-2">
              <Layers size={14} /> Categoría
            </span>
            <p class="font-mono text-xs text-garnet-bright uppercase font-semibold">
              {category}
            </p>
          </div>
        </div>

        <!-- TECH STACK CARD -->
        <div class="bg-ink-2 border border-white/10 rounded-2xl p-6 md:p-8 space-y-4">
          <h3 class="font-mono text-xs text-garnet-bright uppercase tracking-widest font-semibold border-b border-white/10 pb-4">
            // STACK TECNOLÓGICO
          </h3>

          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-white/80 font-mono text-xs hover:border-garnet-bright transition-colors">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </aside>
    </div>

    <!-- BOTTOM PROJECT NAVIGATION -->
    <nav class="mt-24 pt-12 border-t border-white/10 grid grid-cols-1 sm:grid-cols-2 gap-6">
      <a
        href={`/proyectos/${prevProject.data.id}`}
        class="bg-ink-2 border border-white/10 hover:border-garnet/50 rounded-xl p-6 transition-all duration-300 group no-underline flex flex-col justify-between"
      >
        <span class="font-mono text-[10px] text-white/40 uppercase tracking-widest mb-2 flex items-center gap-1">
          <ArrowLeft size={12} /> PROYECTO ANTERIOR
        </span>
        <span class="font-display font-bold text-xl text-white group-hover:text-garnet-bright transition-colors">
          {prevProject.data.title}
        </span>
      </a>

      <a
        href={`/proyectos/${nextProject.data.id}`}
        class="bg-ink-2 border border-white/10 hover:border-garnet/50 rounded-xl p-6 transition-all duration-300 group no-underline flex flex-col justify-between text-right"
      >
        <span class="font-mono text-[10px] text-white/40 uppercase tracking-widest mb-2 flex items-center justify-end gap-1">
          PROYECTO SIGUIENTE <ArrowRight size={12} />
        </span>
        <span class="font-display font-bold text-xl text-white group-hover:text-garnet-bright transition-colors">
          {nextProject.data.title}
        </span>
      </a>
    </nav>
  </main>
</Layout>

<script>
  import { gsap } from 'gsap';

  type CarouselApi = { root: HTMLElement; next: () => void; prev: () => void };

  const carousels: CarouselApi[] = [];
  let activeRoot: HTMLElement | null = null;
  let keyboardBound = false;

  function setupCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    if (!track) return;

    const count = track.children.length;
    if (count === 0) return;

    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-carousel-dot]'));
    const prevBtn = root.querySelector('[data-carousel-prev]');
    const nextBtn = root.querySelector('[data-carousel-next]');
    let index = 0;

    // --- Ajuste de la pantalla a la proporción de la captura ---
    const isMobile = root.dataset.variant === 'mobile';
    // Límites para que una captura extrema (p. ej. página completa muy larga)
    // no deforme el dispositivo. Ajusta a tu gusto (ancho / alto).
    const [minRatio, maxRatio] = isMobile ? [0.42, 0.8] : [1, 2.4];

    const slideImgs = Array.from(track.children).map(
      (slide) => slide.querySelector<HTMLImageElement>('img')
    );

    let firstFit = true;
    function fitToSlide() {
      const img = slideImgs[index];
      if (!img || !img.naturalWidth || !img.naturalHeight) return; // placeholder o imagen rota: se queda el ratio por defecto

      const ratio = Math.min(maxRatio, Math.max(minRatio, img.naturalWidth / img.naturalHeight));

      if (firstFit) root.style.transition = 'none'; // sin animar el primer ajuste
      root.style.aspectRatio = String(ratio);
      if (firstFit) {
        void root.offsetHeight; // fuerza reflow antes de restaurar la transición
        root.style.transition = '';
        firstFit = false;
      }
    }

    slideImgs.forEach((img, i) => {
      img?.addEventListener('load', () => {
        if (i === index) fitToSlide();
      });
    });
    // --- fin del ajuste ---

    function render() {
      track!.style.transform = `translateX(-${index * 100}%)`;

      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.remove('bg-white/30', 'w-2.5');
          dot.classList.add('bg-garnet-bright', 'w-6');
        } else {
          dot.classList.remove('bg-garnet-bright', 'w-6');
          dot.classList.add('bg-white/30', 'w-2.5');
        }
      });

      fitToSlide();
    }

    function go(i: number) {
      index = (i + count) % count;
      render();
    }

    const api: CarouselApi = {
      root,
      next: () => go(index + 1),
      prev: () => go(index - 1),
    };
    carousels.push(api);

    prevBtn?.addEventListener('click', api.prev);
    nextBtn?.addEventListener('click', api.next);
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const i = Number(dot.getAttribute('data-index'));
        if (!Number.isNaN(i)) go(i);
      });
    });

    // El teclado controla el carrusel sobre el que estés (o el último que tocaste)
    const markActive = () => { activeRoot = root; };
    root.addEventListener('pointerenter', markActive);
    root.addEventListener('focusin', markActive);
    root.addEventListener('click', markActive);

    // Swipe táctil
    let startX = 0;
    root.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) < 40) return;
      if (dx < 0) api.next();
      else api.prev();
    });

    render();
  }

  function bindKeyboard() {
    if (keyboardBound) return;
    keyboardBound = true;

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      if (document.querySelector('dialog[open]')) return; // modal abierto: no mover el carrusel

      const live = carousels.filter((c) => c.root.isConnected);
      const target = live.find((c) => c.root === activeRoot) ?? live[0];
      if (!target) return;

      if (e.key === 'ArrowLeft') target.prev();
      else target.next();
    });
  }

  function init() {
    // Limpia carruseles de páginas anteriores (navegación con View Transitions)
    for (let i = carousels.length - 1; i >= 0; i--) {
      if (!carousels[i].root.isConnected) carousels.splice(i, 1);
    }

    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      setupCarousel(root);
    });

    bindKeyboard();

    const header = document.getElementById('project-header');
    const banner = document.getElementById('project-banner');
    if (header && banner && !header.dataset.animated) {
      header.dataset.animated = 'true';
      gsap.fromTo(
        [header, banner],
        { opacity: 0, y: 30 },
        { opacity: 1, y: 0, duration: 0.8, stagger: 0.2, ease: 'power3.out' }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  document.addEventListener('astro:page-load', init);
</script>
