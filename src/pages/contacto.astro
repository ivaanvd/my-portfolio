---
import Layout from '../layouts/Layout.astro';
import { Mail, MapPin, Send, Phone } from '@lucide/astro';
---

<Layout title="Contacto — Iván Vayad">
  <main class="min-h-dvh bg-ink text-white pt-36 px-6 md:px-16 max-w-5xl mx-auto pb-24">
    <p class="font-mono text-xs text-garnet-bright tracking-widest uppercase mb-4 font-semibold">
      // CONTACTO
    </p>

    <h1 class="font-display font-black text-5xl md:text-7xl uppercase leading-none mb-8 tracking-tight">
      ¿Hablamos de <br />
      <span class="text-garnet-bright italic">tu próximo proyecto?</span>
    </h1>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mt-12">
      <div class="space-y-6 text-white/80 font-sans">
        <p class="text-lg leading-relaxed">
          Estudiante de último curso de Ingeniería Informática con especialización en Ingeniería del Software. Disponible para ofertas laborales, proyectos y consultas técnicas.
        </p>

        <div class="space-y-4 pt-4 font-mono text-sm">
          <div class="flex items-center gap-3">
            <Mail size={18} class="text-garnet-bright shrink-0" />
            <a href="mailto:ivanvayad.2004@gmail.com" class="hover:text-garnet-bright transition-colors">ivanvayad.2004@gmail.com</a>
          </div>

          <div class="flex items-center gap-3">
            <Phone size={18} class="text-garnet-bright shrink-0" />
            <a href="tel:+34652260021" class="hover:text-garnet-bright transition-colors">+34 652 26 00 21</a>
          </div>

          <div class="flex items-center gap-3">
            <MapPin size={18} class="text-garnet-bright shrink-0" />
            <span>Zaragoza, España</span>
          </div>

          <div class="flex items-center gap-4 pt-4">
            <a href="https://github.com/ivaanvd" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="p-3 bg-white/5 border border-white/10 rounded-lg hover:border-garnet-bright hover:text-garnet-bright transition-all">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            </a>
            <a href="https://www.linkedin.com/in/ivan-vayad-63b6a9338/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="p-3 bg-white/5 border border-white/10 rounded-lg hover:border-garnet-bright hover:text-garnet-bright transition-all">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <form id="contact-form" class="bg-ink-2 p-8 rounded-xl border border-white/10 space-y-4 font-mono text-xs relative">
        <div class="text-garnet-bright font-bold border-b border-white/10 pb-2 text-sm flex items-center justify-between">
          <span>ENVIAR_MENSAJE.SH</span>
          <span class="text-[10px] text-white/40">DIRECT_EMAIL</span>
        </div>

        <div id="contact-status" class="hidden p-3 rounded text-xs font-mono mb-2"></div>

        <div>
          <label class="block text-white/60 mb-2">NOMBRE</label>
          <input id="contact-name" name="name" type="text" class="w-full bg-black/40 border border-white/10 rounded px-4 py-3 text-white focus:outline-none focus:border-garnet-bright" placeholder="Tu nombre" required />
        </div>

        <div>
          <label class="block text-white/60 mb-2">EMAIL</label>
          <input id="contact-email" name="email" type="email" class="w-full bg-black/40 border border-white/10 rounded px-4 py-3 text-white focus:outline-none focus:border-garnet-bright" placeholder="tu@email.com" required />
        </div>

        <div>
          <label class="block text-white/60 mb-2">MENSAJE</label>
          <textarea id="contact-message" name="message" rows="4" class="w-full bg-black/40 border border-white/10 rounded px-4 py-3 text-white focus:outline-none focus:border-garnet-bright" placeholder="Cuéntame sobre tu proyecto..." required></textarea>
        </div>

        <button id="contact-btn" type="submit" class="w-full bg-garnet text-white font-mono uppercase tracking-wider py-3.5 rounded font-semibold hover:bg-garnet-bright transition-colors flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50">
          <Send size={14} />
          <span>ENVIAR MENSAJE</span>
        </button>
      </form>
    </div>
  </main>
</Layout>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const btn = document.getElementById('contact-btn') as HTMLButtonElement | null;
    const status = document.getElementById('contact-status');

    if (!form || !btn || !status || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const name = (document.getElementById('contact-name') as HTMLInputElement)?.value;
      const email = (document.getElementById('contact-email') as HTMLInputElement)?.value;
      const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value;

      btn.disabled = true;
      btn.innerHTML = `<span class="preloader-dots">ENVIANDO</span>`;
      status.className = 'hidden';

      try {
        const response = await fetch('https://formsubmit.co/ajax/ivanvayad.2004@gmail.com', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            name,
            email,
            message,
            _subject: `Nuevo mensaje en Portfolio de ${name}`
          })
        });

        if (response.ok) {
          status.className = 'p-3 rounded text-xs font-mono mb-2 bg-green-500/10 border border-green-500/30 text-green-400 block';
          status.textContent = '✓ ¡Mensaje enviado con éxito! Te responderé lo antes posible a tu correo.';
          form.reset();
        } else {
          throw new Error('Error al enviar mensaje');
        }
      } catch (err) {
        status.className = 'p-3 rounded text-xs font-mono mb-2 bg-red-500/10 border border-red-500/30 text-red-400 block';
        status.textContent = '✕ Hubo un problema al enviar el correo. Por favor escríbeme directamente a ivanvayad.2004@gmail.com';
      } finally {
        btn.disabled = false;
        btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg><span>ENVIAR MENSAJE</span>`;
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupContactForm);
  } else {
    setupContactForm();
  }
  document.addEventListener('astro:page-load', setupContactForm);
</script>
